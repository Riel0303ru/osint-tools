{
    "project_name": "OSINT Fusion",
    "version": "1.0",
    "theme": {
        "primary_color": "cyan",
        "secondary_color": "green",
        "warning_color": "yellow",
        "error_color": "red"
    },
    "runtime": {
        "timeout": 10,
        "retries": 2,
        "verify_ssl": true
    },
    "output": {
        "folder": "outputs",
        "save_json": true,
        "save_txt": false,
        "save_html": false
    },
    "modules": {
        "username": true,
        "email": true,
        "domain": true,
        "phone": true,
        "image": true,
        "ai": true,
        "graph": true
    },
    "network": {
        "user_agent": "OSINT-Fusion/1.0"
    }
}